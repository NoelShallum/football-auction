{
  "name": "auctionxi-clone",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Self-contained local clone of Auction XI with an independent realtime room service.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:container": "node scripts/smoke-container.mjs",
    "verify": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "@napi-rs/canvas": "^0.1.80"
  }
}
