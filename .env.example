# Environment variables are optional. Export them before npm start.
HOST=0.0.0.0
PORT=3000
# Room snapshots are private runtime data, excluded from Git.
ROOM_DATA_FILE=./data/rooms.json
# Remove inactive rooms after 24 hours.
ROOM_TTL_HOURS=24
# Optional comma-separated browser origins when running behind a reverse proxy.
# ALLOWED_ORIGINS=https://your-private-host.example
